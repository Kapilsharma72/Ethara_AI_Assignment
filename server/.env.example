# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/team_task_manager

# JWT signing secret — must be at least 32 characters, keep this private
JWT_SECRET=replace-this-with-a-random-string-of-at-least-32-characters

# Allowed frontend origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# Port the server listens on (Railway injects this automatically in production)
PORT=3000
